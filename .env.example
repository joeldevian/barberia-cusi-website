# ==================================
# SUPABASE - Base de Datos y Auth
# ==================================
# Obtén estas credenciales desde: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-key-publica-aqui"

# ==================================
# GOOGLE ANALYTICS (Opcional)
# ==================================
# Crea una propiedad GA4 en: https://analytics.google.com/
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# ==================================
# WHATSAPP (Para confirmaciones)
# ==================================
# Número de teléfono con código de país
WHATSAPP_PHONE="+51912926255"

# ==================================
# ADMIN CREDENTIALS (Opcional)
# ==================================
# Solo necesario para crear el primer usuario admin
# Después de crear, puedes eliminar estas líneas
ADMIN_EMAIL="admin@barberiacusi.com"
ADMIN_PASSWORD="tu-password-seguro-aqui"

# ==================================
# CONFIGURACIÓN DEL ENTORNO
# ==================================
# development | production
NODE_ENV="development"

# ==================================
# NOTAS IMPORTANTES
# ==================================
# 1. NO subas el archivo .env al repositorio
# 2. Copia este archivo a .env y completa con tus credenciales
# 3. Las variables que empiezan con NEXT_PUBLIC_ son públicas (visibles en el cliente)
# 4. Configura estas variables en tu plataforma de deployment (Vercel, etc.)

